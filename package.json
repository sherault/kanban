{
  "name": "kanban",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\" --ignore-path .gitignore",
    "agent:install": "node scripts/kanban-agent-install.mjs",
    "agent:env": "node scripts/kanban-agent-env.mjs",
    "agent:install:smoke": "node scripts/agent-install/smoke-test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.59.1",
    "prettier": "^3.3.3",
    "tsdown": "^0.21.9",
    "turbo": "^2.10.7",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "vite@<8.1.5": ">=8.1.5",
      "hono@<4.12.34": ">=4.12.34",
      "drizzle-orm@<0.45.2": ">=0.45.2",
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "postcss@<=8.5.17": ">=8.5.18",
      "ip-address@<10.3.1": ">=10.3.1",
      "fast-uri@<4.1.2": ">=4.1.2",
      "brace-expansion@<2": "1.1.16",
      "brace-expansion@>=2 <3": "2.1.3",
      "brace-expansion@>=3": "5.0.9",
      "ws@>=8.0.0 <8.21.1": ">=8.21.1",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "sharp@<0.35.0": ">=0.35.0",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "@babel/core@<=7.29.0": ">=7.29.7",
      "turbo@<2.9.14": ">=2.9.14",
      "vitest@<3.2.6": ">=3.2.6",
      "nodemailer@<=9.0.0": ">=9.0.1"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,json,md}": [
      "prettier --write"
    ],
    "**/*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
